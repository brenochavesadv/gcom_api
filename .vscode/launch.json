{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Python: Flask backend",
            "type": "python",
            "request": "launch",
            "module": "flask",
            "cwd": "${workspaceFolder}/backend",
            "env": {
                "FLASK_DEBUG": "1",
                "FLASK_APP": "main:create_app",
                "FLASK_ENV": "development"
            },
            "args": [
                "run",
                "--no-debugger",
                "--no-reload"
            ],
            "jinja": true
        }
    ]
}
